PORT=4000
MONGO_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Tuỳ chọn (đã có giá trị mặc định)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800
# BCRYPT_ROUNDS=12

# Production (Render/Railway)
# NODE_ENV=production
# TRUST_PROXY=1
# CORS_ORIGINS=https://your-web-app.example

# AI (Phase 18) - lấy key tại https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Push notification (Phase 19)
# CRON_SECRET=           # >= 32 ký tự, bảo vệ POST /api/internal/weekly-report
# EXPO_ACCESS_TOKEN=     # chỉ cần khi bật Enhanced push security trên EAS

# Quên mật khẩu - gửi mã qua email (https://resend.com). Không có key thì máy dev in mã ra log server.
# RESEND_API_KEY=
# MAIL_FROM=FitTrack <no-reply@your-domain.com>
